# Copy to .env and fill in. Schema of record: src/lib/env.ts

# --- Database ---
# Local: matches docker/postgres/init.sql. Production: the Neon pooled connection string.
DATABASE_URL=postgresql://photography:photography@localhost:5432/photography

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional. Public base URL of the site; taken from the request when unset.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated. Only these emails can sign in to /admin.
ADMIN_EMAILS=

# --- Cloudflare R2 (photo storage) ---
# The defaults target the S3 mock from docker/docker-compose.yml, which takes any credentials.
# Production: https://<account id>.r2.cloudflarestorage.com, and an "Object Read & Write"
# token for the bucket from R2 > Manage API tokens.
R2_ENDPOINT=http://localhost:9090
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_BUCKET=photography

# --- Email / SMTP (sign-in codes) ---
# Defaults target the mailpit container from docker/docker-compose.yml.
# Leave these unset for local dev; inbox UI is at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# "true" or "false"
SMTP_SECURE=false
# Optional; auth is only sent when BOTH user and password are set
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Photography <noreply@photography.local>

# --- Images (public, sent to the browser) ---
# No trailing slash. The default serves originals from the local S3 mock.
# Production: the custom domain on the R2 bucket, in a Cloudflare zone with Image
# Transformations on (r2.dev URLs do not support transformations), and
# VITE_IMAGE_TRANSFORMS=true.
VITE_IMAGES_URL=http://localhost:9090/photography
# "false" serves each original at full size, for storage without Cloudflare Image Transformations.
VITE_IMAGE_TRANSFORMS=false
